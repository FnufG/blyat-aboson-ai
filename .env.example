# Copy this file to .env.local. Values remain on the server and out of Git.
LLM_BACKEND=cloud
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Optional natural voice provider. Without a key, English eSpeak test speech is used.
BOSON_API_KEY=
BOSON_BASE_URL=https://api.boson.ai/v1
BOSON_MODEL=higgs-audio-v3-tts
# BOSON_VOICE=  # Use a voice supported by your Boson account.

# LiveKit credentials are generated in .local/runtime.env; do not set public dev keys.
# For deployment use HTTPS, a reachable WSS LiveKit endpoint and ICE/TURN:
# LIVEKIT_PUBLIC_URL=wss://media.your-domain.example
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_BIND_ADDRESS=127.0.0.1
# LIVEKIT_NODE_IP=127.0.0.1

# Optional local development mode (requires a separate Qwen download):
# LLM_BACKEND=local
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:1.5b
# Extractive text-only development mode: LLM_BACKEND=faq

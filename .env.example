# Local answers are the default. No OpenAI key or paid LLM quota is needed.
LLM_BACKEND=local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b

# Optional natural speech. Without a key, labelled English eSpeak test speech is used.
BOSON_API_KEY=
BOSON_BASE_URL=https://api.boson.ai/v1
BOSON_MODEL=higgs-audio-v3-tts
# BOSON_VOICE=  # Use a voice supported by your Boson account.

# Local LiveKit credentials are generated in .local/runtime.env.
# Public deployment additionally requires HTTPS, reachable WSS and ICE/TURN.
# LIVEKIT_PUBLIC_URL=wss://media.your-domain.example
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_BIND_ADDRESS=127.0.0.1
# LIVEKIT_NODE_IP=127.0.0.1

# Optional native development only: cloud model configuration must be explicit.
# The supplied compose.yaml intentionally pins local mode even if these are set.
# LLM_BACKEND=cloud
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=
# Extractive text-only development mode: LLM_BACKEND=faq

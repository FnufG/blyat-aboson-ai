# Default: local Whisper + Qwen; no extra cloud API keys.
LLM_BACKEND=local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b

# The only external key needed for Boson voice. Keep it on the server.
# Without it the explicitly labelled eSpeak test voice is used.
BOSON_API_KEY=
BOSON_BASE_URL=https://api.boson.ai/v1
BOSON_MODEL=higgs-audio-v3-tts
# BOSON_VOICE=  # Set only to a voice supported by your Boson account.

# LiveKit credentials are generated for the local server in .local/runtime.env.
# For a deployed HTTPS app use a reachable WSS endpoint and configure ICE/TURN:
# LIVEKIT_PUBLIC_URL=wss://media.your-domain.example
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_BIND_ADDRESS=127.0.0.1
# LIVEKIT_NODE_IP=127.0.0.1  # Local browser ICE; set the correct reachable IP for deployment.

# Optional alternative: cloud LLM, not needed for default local operation.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# To run only the original extractive text demo: LLM_BACKEND=faq
